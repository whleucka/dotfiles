# ripgrep config — loaded via $RIPGREP_CONFIG_PATH
#
# One argument per line. Applies to every `rg` invocation, including the ones
# mini.pick shells out to for `files` and `grep_live` (it passes no --hidden of
# its own, which hid the entire stow tree since every path here is pkg/.config/...).

# Traverse hidden files/dirs. .gitignore rules still apply.
--hidden

# ...but never these.
--glob=!.git/*
--glob=!node_modules/*
--glob=!vendor/*
