#!/usr/bin/env bash
# herdr scrollback pager — dump a pane's scrollback WITH its ANSI colors and
# read it in neovim.
#
# herdr's built-in edit_scrollback (ctrl+shift+g) dumps plain text: it strips
# every escape sequence, so diffs, test output, and agent UIs arrive colorless.
# `herdr pane read --format ansi` keeps the SGR sequences, so we capture that
# instead and let neovim render them as real highlights (see nvim's
# ftplugin/ansi.lua, which drives baleia.nvim).
#
# Invoked from herdr as a popup keybinding (see ~/.config/herdr/config.toml):
#     scrollback --from-popup
# or by hand inside any pane, optionally naming the pane:
#     scrollback [PANE_ID]
#
# Env overrides:
#   HERDR_SCROLLBACK_LINES   rows to capture (default 10000; herdr caps at
#                            whatever host scrollback it still retains)
#   HERDR_SCROLLBACK_SOURCE  visible | recent | recent-unwrapped (default) |
#                            detection — "recent-unwrapped" rejoins terminal
#                            line wrapping, which is what you want for reading
#                            and copying.
#   HERDR_SCROLLBACK_VIEWER  viewer command (default nvim)
#   HERDR_SCROLLBACK_DEBUG   1 = append resolution details to
#                            $XDG_RUNTIME_DIR/herdr-scrollback.log

set -uo pipefail

# The herdr server is a lazy daemon started by the first client from Hyprland,
# so it captured a session PATH without ~/.local/bin — where the herdr binary
# lives. Keybind commands inherit that PATH. Same fix as herdr-nav.
export PATH="$HOME/.local/bin:$PATH"

lines=${HERDR_SCROLLBACK_LINES:-10000}
source_kind=${HERDR_SCROLLBACK_SOURCE:-recent-unwrapped}
runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
logfile="$runtime_dir/herdr-scrollback.log"

from_popup=0
pane_arg=""
for arg in "$@"; do
  case "$arg" in
    --from-popup) from_popup=1 ;;
    -*) printf 'scrollback: unknown option %s\n' "$arg" >&2; exit 2 ;;
    *) pane_arg="$arg" ;;
  esac
done

log() {
  [ "${HERDR_SCROLLBACK_DEBUG:-0}" = "0" ] && return 0
  printf '%s\n' "$*" >>"$logfile"
}

die() {
  printf 'scrollback: %s\n' "$*" >&2
  notify-send -a herdr "scrollback" "$*" 2>/dev/null
  # Popups vanish the instant the command exits, so hold the message on screen.
  [ "$from_popup" = "1" ] && read -r -n 1 -p "press any key…"
  exit 1
}

# --- which pane are we paging? ---------------------------------------------
# Every pid between us and init. Used to recognize a pane we are running
# *inside*: when herdr opens this script in a popup, the popup — not the pane
# the user was reading — is what "focused" resolves to, and paging our own
# viewer would be useless.
self_pids() {
  local pid=$$
  while [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "1" ]; do
    printf '%s\n' "$pid"
    pid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)
  done
}

# The session's focused pane. `pane list` is scoped to the whole session, unlike
# `pane layout`, which reports the focused pane of *a* tab (its default tab is
# not necessarily the one you are looking at) and so can name a pane in another
# tab entirely.
focused_pane() {
  herdr pane list 2>/dev/null |
    jq -r '.result.panes[] | select(.focused).pane_id' | head -1
}

pane_shell_pid() {
  herdr pane process-info --pane "$1" 2>/dev/null |
    jq -r '.result.process_info.shell_pid // empty'
}

ancestors=$(self_pids)

# Accept a candidate unless it is the terminal we are running in (popup only).
usable_pane() {
  local candidate=$1 shell_pid
  [ -n "$candidate" ] || return 1
  shell_pid=$(pane_shell_pid "$candidate") || return 1
  [ -n "$shell_pid" ] || return 1
  if [ "$from_popup" = "1" ] && grep -qx "$shell_pid" <<<"$ancestors"; then
    log "reject $candidate (shell_pid $shell_pid is our own terminal)"
    return 1
  fi
  return 0
}

if [ -n "$pane_arg" ] && ! usable_pane "$pane_arg"; then
  die "no such pane: $pane_arg"
fi

pane=""
for candidate in "$pane_arg" "${HERDR_PANE_ID:-}" "$(focused_pane)"; do
  if usable_pane "$candidate"; then
    pane=$candidate
    log "using pane $candidate (arg='$pane_arg' env='${HERDR_PANE_ID:-}' popup=$from_popup)"
    break
  fi
done

[ -n "$pane" ] || die "could not resolve a pane to read (see $logfile with HERDR_SCROLLBACK_DEBUG=1)"

# --- capture ---------------------------------------------------------------
dump=$(mktemp "$runtime_dir/herdr-scrollback-XXXXXX.ansi") || die "mktemp failed"
trap 'rm -f "$dump"' EXIT

herdr pane read "$pane" --source "$source_kind" --lines "$lines" --format ansi >"$dump" ||
  die "herdr pane read $pane failed"
[ -s "$dump" ] || die "pane $pane has no scrollback to show"

# --- read it ---------------------------------------------------------------
cwd=$(herdr pane get "$pane" 2>/dev/null | jq -r '.result.pane.cwd // empty')
viewer=${HERDR_SCROLLBACK_VIEWER:-nvim}
viewer_args=()
if [ "$viewer" = "nvim" ]; then
  # -n: no swapfile for a throwaway file. Start in the pane's cwd so gf, :grep,
  # and pickers resolve the paths that scroll by in the dump.
  viewer_args=(-n)
  # `cd` is a Vim command, so spaces in the path need Vim-level escaping.
  [ -n "$cwd" ] && viewer_args+=(--cmd "cd ${cwd// /\\ }")
fi
HERDR_SCROLLBACK_PANE="$pane" "$viewer" "${viewer_args[@]}" "$dump"
