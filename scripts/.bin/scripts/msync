#!/usr/bin/env bash

# msync - Mutagen Sync Manager
#
# Manage mutagen sync sessions with fzf, backed by a simple config file.
#
# Usage:
#   msync                    Interactive project picker (fzf)
#   msync list               List active sync sessions
#   msync start <name>       Start syncing a project
#   msync stop <name>        Stop syncing a project
#   msync status <name>      Show detailed sync status
#   msync add                Add a new project to config
#   msync remove <name>      Remove a project from config
#   msync edit               Open config in $EDITOR
#
# Config: ~/.config/msync/config.yml (YAML)

CONFIG_DIR="$HOME/.config/msync"
CONFIG_FILE="$CONFIG_DIR/config.yml"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

info()  { printf "${BLUE}:: ${NC}%s\n" "$*"; }
ok()    { printf "${GREEN}:: ${NC}%s\n" "$*"; }
warn()  { printf "${YELLOW}:: ${NC}%s\n" "$*"; }
err()   { printf "${RED}:: ${NC}%s\n" "$*" >&2; }

# ── Setup ────────────────────────────────────────────────────────────────────

ensure_config() {
    if [ ! -d "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR"
    fi
    if [ ! -f "$CONFIG_FILE" ]; then
        cat > "$CONFIG_FILE" << 'EOF'
# msync project config
# Each project needs: name, host, remote_dir, local_dir

projects: []
# Example:
# projects:
#   - name: myapp
#     host: prod-server
#     remote_dir: /var/www/myapp
#     local_dir: ~/projects/myapp
EOF
        info "Created config at $CONFIG_FILE"
        info "Add projects with 'msync add' or edit directly."
    fi
}

check_yq() {
    if ! command -v yq &>/dev/null; then
        err "yq not found. Install with: pip install yq"
        exit 1
    fi
}

check_mutagen() {
    if ! command -v mutagen &>/dev/null; then
        err "mutagen not found. Install with: yay -S mutagen.io-bin"
        exit 1
    fi
}

# ── Config Helpers ───────────────────────────────────────────────────────────

# Read config entries as pipe-delimited lines: name|host|remote_dir|local_dir
read_config() {
    yq -r '.projects[]? | "\(.name)|\(.host)|\(.remote_dir)|\(.local_dir)"' "$CONFIG_FILE" 2>/dev/null
}

get_project() {
    local name="$1"
    read_config | grep "^${name}|"
}

list_project_names() {
    yq -r '.projects[]?.name' "$CONFIG_FILE" 2>/dev/null
}

# ── Session Helpers ──────────────────────────────────────────────────────────

is_session_active() {
    local name="$1"
    mutagen sync list --label-selector="msync=${name}" 2>/dev/null | grep -q "Status:"
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_start() {
    local name="$1"
    if [ -z "$name" ]; then
        err "No project specified."
        return 1
    fi

    local entry
    entry=$(get_project "$name")
    if [ -z "$entry" ]; then
        err "Project '$name' not found in config."
        return 1
    fi

    if is_session_active "$name"; then
        warn "Session '$name' is already active."
        return 0
    fi

    local host remote_dir local_dir
    IFS='|' read -r _ host remote_dir local_dir <<< "$entry"
    local_dir="${local_dir/#\~/$HOME}"

    if [ ! -d "$local_dir" ]; then
        printf "Local dir '${CYAN}%s${NC}' doesn't exist. Create it? [Y/n]: " "$local_dir"
        read -r yn
        case "$yn" in
            [nN]*) return 1 ;;
            *) mkdir -p "$local_dir" && ok "Created $local_dir" ;;
        esac
    fi

    info "Starting sync: ${CYAN}$local_dir${NC} <-> ${CYAN}$host:$remote_dir${NC}"
    mutagen sync create "$local_dir" "${host}:${remote_dir}" \
        --name="msync-${name}" \
        --label="msync=${name}" \
        --ignore-vcs \
        --default-file-mode=0644 \
        --default-directory-mode=0755

    if [ $? -eq 0 ]; then
        ok "Syncing '$name'"
    else
        err "Failed to start sync for '$name'"
        return 1
    fi
}

cmd_stop() {
    local name="$1"
    if [ -z "$name" ]; then
        err "No project specified."
        return 1
    fi

    if ! is_session_active "$name"; then
        warn "No active session for '$name'."
        return 0
    fi

    mutagen sync terminate --label-selector="msync=${name}"
    if [ $? -eq 0 ]; then
        ok "Stopped '$name'"
    else
        err "Failed to stop '$name'"
        return 1
    fi
}

cmd_status() {
    local name="$1"
    if [ -z "$name" ]; then
        mutagen sync list
    else
        mutagen sync list --label-selector="msync=${name}"
    fi
}

cmd_list() {
    local entries
    entries=$(read_config)
    if [ -z "$entries" ]; then
        warn "No projects configured. Run 'msync add' to add one."
        return 0
    fi

    while IFS='|' read -r name host remote_dir local_dir; do
        if is_session_active "$name"; then
            state="${GREEN}syncing${NC}"
        else
            state="${DIM}stopped${NC}"
        fi
        printf "%-20s %b%-25s${NC} %s:%s  %b\n" "$name" "$CYAN" "$local_dir" "$host" "$remote_dir" "$state"
    done <<< "$entries"
}

cmd_add() {
    local name host remote_dir local_dir

    printf "Project name: "
    read -r name
    [ -z "$name" ] && { err "No name provided."; return 1; }

    if get_project "$name" &>/dev/null; then
        err "Project '$name' already exists."
        return 1
    fi

    # Pick host from ssh config via fzf
    local hosts
    hosts=$(grep ^Host "$HOME/.ssh/config" 2>/dev/null | awk '{ print $2 }' | tail -n+2 | sort)
    if [ -n "$hosts" ]; then
        info "Select SSH host (or Esc to type manually):"
        host=$(printf '%s\n' "$hosts" | fzf --height=10 --prompt="Host: ")
    fi
    if [ -z "$host" ]; then
        printf "SSH host: "
        read -r host
        [ -z "$host" ] && { err "No host provided."; return 1; }
    fi

    printf "Remote directory: "
    read -r remote_dir
    [ -z "$remote_dir" ] && { err "No remote dir provided."; return 1; }

    printf "Local directory [~/.mount/%s]: " "$name"
    read -r local_dir
    [ -z "$local_dir" ] && local_dir="~/.mount/$name"

    local tmp
    tmp=$(mktemp)
    yq -y ".projects += [{name: \"$name\", host: \"$host\", remote_dir: \"$remote_dir\", local_dir: \"$local_dir\"}]" "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
    ok "Added '$name' ($host:$remote_dir -> $local_dir)"
}

cmd_remove() {
    local name="$1"
    if [ -z "$name" ]; then
        err "No project specified."
        return 1
    fi

    if [ -z "$(get_project "$name")" ]; then
        err "Project '$name' not found."
        return 1
    fi

    # Stop if active
    if is_session_active "$name"; then
        cmd_stop "$name"
    fi

    printf "Remove '${RED}%s${NC}' from config? [y/N]: " "$name"
    read -r yn
    case "$yn" in
        [yY]*)
            local tmp
            tmp=$(mktemp)
            yq -y ".projects |= map(select(.name != \"$name\"))" "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
            ok "Removed '$name'"
            ;;
        *) info "Cancelled." ;;
    esac
}

cmd_edit() {
    ${EDITOR:-nvim} "$CONFIG_FILE"
}

# ── Interactive Mode ─────────────────────────────────────────────────────────

interactive() {
    local entries
    entries=$(read_config)

    if [ -z "$entries" ]; then
        warn "No projects configured."
        printf "Add one now? [Y/n]: "
        read -r yn
        case "$yn" in
            [nN]*) return 0 ;;
            *) cmd_add; return $? ;;
        esac
    fi

    # Build display with status
    local display=""
    while IFS='|' read -r name host remote_dir local_dir; do
        if is_session_active "$name"; then
            state="[syncing]"
        else
            state="[stopped]"
        fi
        display+=$(printf "%-18s %-10s %s:%s  %s" "$name" "$state" "$host" "$remote_dir" "$local_dir")
        display+=$'\n'
    done <<< "$entries"
    display=$(echo "$display" | sed '/^\s*$/d')

    local result
    result=$(printf '%s' "$display" | fzf \
        --header "Enter:toggle | Del:remove | ^A:add | ^E:edit config | Esc:quit" \
        --expect=del,ctrl-a,ctrl-e \
        --ansi)

    if [ -z "$result" ]; then
        return 0
    fi

    local key selection name
    key=$(echo "$result" | sed -n '1p')
    selection=$(echo "$result" | sed -n '2p')
    name=$(echo "$selection" | awk '{print $1}')

    case "$key" in
        del)
            [ -n "$name" ] && cmd_remove "$name"
            ;;
        ctrl-a)
            cmd_add
            ;;
        ctrl-e)
            cmd_edit
            ;;
        *)
            # Enter — toggle sync on/off
            if [ -n "$name" ]; then
                if is_session_active "$name"; then
                    cmd_stop "$name"
                else
                    cmd_start "$name"
                fi
            fi
            ;;
    esac
}

# ── Main ─────────────────────────────────────────────────────────────────────

check_mutagen
check_yq
ensure_config

case "${1:-}" in
    start)
        cmd_start "$2"
        ;;
    stop)
        cmd_stop "$2"
        ;;
    status|st)
        cmd_status "$2"
        ;;
    list|ls)
        cmd_list
        ;;
    add)
        cmd_add
        ;;
    remove|rm)
        cmd_remove "$2"
        ;;
    edit)
        cmd_edit
        ;;
    help|-h|--help)
        cat << 'EOF'
msync - Mutagen Sync Manager

Usage:
  msync                    Interactive project picker (fzf)
  msync list               List projects and sync status
  msync start <name>       Start syncing a project
  msync stop <name>        Stop syncing a project
  msync status [name]      Show detailed mutagen status
  msync add                Add a new project to config
  msync remove <name>      Remove a project from config
  msync edit               Open config in $EDITOR

Interactive keybindings (fzf):
  Enter    Toggle sync on/off for selected project
  Del      Remove project from config
  Ctrl-A   Add a new project
  Ctrl-E   Edit config file
  Esc      Exit

Config: ~/.config/msync/config.yml (YAML)
EOF
        ;;
    *)
        interactive
        ;;
esac
