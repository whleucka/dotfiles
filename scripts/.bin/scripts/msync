#!/usr/bin/env python3

# msync - Mutagen Sync Manager
#
# Manage mutagen sync sessions with fzf, backed by a TOML config file.
#
# Usage:
#   msync                    Interactive project picker (fzf)
#   msync list               List active sync sessions
#   msync start <name>       Start syncing a project
#   msync stop <name>        Stop syncing a project
#   msync status [name]      Show detailed sync status
#   msync add                Add a new project to config
#   msync remove <name>      Remove a project from config
#   msync edit               Open config in $EDITOR
#
# Config: ~/.config/msync/config.toml

import os
import sys
import shutil
import subprocess
import tomllib
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "msync"
CONFIG_FILE = CONFIG_DIR / "config.toml"

# Colors
RED = "\033[0;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
BLUE = "\033[0;34m"
CYAN = "\033[0;36m"
DIM = "\033[2m"
NC = "\033[0m"


def info(msg):
    print(f"{BLUE}::{NC} {msg}")


def ok(msg):
    print(f"{GREEN}::{NC} {msg}")


def warn(msg):
    print(f"{YELLOW}::{NC} {msg}")


def err(msg):
    print(f"{RED}::{NC} {msg}", file=sys.stderr)


# ── Config ──────────────────────────────────────────────────────────────────


def read_config():
    if not CONFIG_FILE.exists():
        return {"projects": {}}
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)


def write_config(config):
    lines = ["# msync project config\n"]
    for name, proj in config.get("projects", {}).items():
        lines.append(f"[projects.{name}]")
        for key in ("host", "remote_dir", "local_dir"):
            if key in proj:
                lines.append(f'{key} = "{proj[key]}"')
        lines.append("")
    CONFIG_FILE.write_text("\n".join(lines))


def ensure_config():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_FILE.exists():
        CONFIG_FILE.write_text(
            "# msync project config\n"
            "# Add projects with 'msync add' or edit directly.\n"
            "#\n"
            "# [projects.example]\n"
            '# host = "my-server"\n'
            '# remote_dir = "/var/www/app"\n'
            '# local_dir = "~/projects/app"\n'
        )
        info(f"Created config at {CONFIG_FILE}")
        info("Add projects with 'msync add' or edit directly.")


def get_projects():
    return read_config().get("projects", {})


# ── Session Helpers ─────────────────────────────────────────────────────────


def is_session_active(name):
    result = subprocess.run(
        ["mutagen", "sync", "list", f"--label-selector=msync={name}"],
        capture_output=True,
        text=True,
    )
    return "Status:" in result.stdout


# ── Commands ────────────────────────────────────────────────────────────────


def cmd_start(name):
    if not name:
        err("No project specified.")
        return 1

    projects = get_projects()
    if name not in projects:
        err(f"Project '{name}' not found in config.")
        return 1

    if is_session_active(name):
        warn(f"Session '{name}' is already active.")
        return 0

    proj = projects[name]
    host = proj["host"]
    remote_dir = proj["remote_dir"]
    local_dir = str(Path(proj["local_dir"]).expanduser())

    if not Path(local_dir).is_dir():
        yn = input(
            f"Local dir '{CYAN}{local_dir}{NC}' doesn't exist. Create it? [Y/n]: "
        )
        if yn.lower().startswith("n"):
            return 1
        Path(local_dir).mkdir(parents=True)
        ok(f"Created {local_dir}")

    info(f"Starting sync: {CYAN}{local_dir}{NC} <-> {CYAN}{host}:{remote_dir}{NC}")
    result = subprocess.run(
        [
            "mutagen", "sync", "create", local_dir, f"{host}:{remote_dir}",
            f"--name=msync-{name}",
            f"--label=msync={name}",
            "--ignore-vcs",
            "--default-file-mode=0644",
            "--default-directory-mode=0755",
        ]
    )

    if result.returncode == 0:
        ok(f"Syncing '{name}'")
        return 0
    else:
        err(f"Failed to start sync for '{name}'")
        return 1


def cmd_stop(name):
    if not name:
        err("No project specified.")
        return 1

    if not is_session_active(name):
        warn(f"No active session for '{name}'.")
        return 0

    result = subprocess.run(
        ["mutagen", "sync", "terminate", f"--label-selector=msync={name}"]
    )

    if result.returncode == 0:
        ok(f"Stopped '{name}'")
        return 0
    else:
        err(f"Failed to stop '{name}'")
        return 1


def cmd_status(name=None):
    cmd = ["mutagen", "sync", "list"]
    if name:
        cmd.append(f"--label-selector=msync={name}")
    subprocess.run(cmd)


def cmd_list():
    projects = get_projects()
    if not projects:
        warn("No projects configured. Run 'msync add' to add one.")
        return

    for name, proj in projects.items():
        if is_session_active(name):
            state = f"{GREEN}syncing{NC}"
        else:
            state = f"{DIM}stopped{NC}"
        print(
            f"{name:<20} {CYAN}{proj['local_dir']:<25}{NC} "
            f"{proj['host']}:{proj['remote_dir']}  {state}"
        )


def cmd_add():
    name = input("Project name: ").strip()
    if not name:
        err("No name provided.")
        return 1

    projects = get_projects()
    if name in projects:
        err(f"Project '{name}' already exists.")
        return 1

    # Pick host from ssh config via fzf
    host = None
    ssh_config = Path.home() / ".ssh" / "config"
    if ssh_config.exists():
        hosts = sorted(
            h
            for line in ssh_config.read_text().splitlines()
            if line.startswith("Host ")
            for h in line.split()[1:]
            if "*" not in h
        )
        if hosts:
            info("Select SSH host (or Esc to type manually):")
            result = subprocess.run(
                ["fzf", "--height=10", "--prompt=Host: "],
                input="\n".join(hosts),
                capture_output=True,
                text=True,
            )
            if result.returncode == 0:
                host = result.stdout.strip()

    if not host:
        host = input("SSH host: ").strip()
        if not host:
            err("No host provided.")
            return 1

    remote_dir = input("Remote directory: ").strip()
    if not remote_dir:
        err("No remote dir provided.")
        return 1

    local_dir = input(f"Local directory [~/.mount/{name}]: ").strip()
    if not local_dir:
        local_dir = f"~/.mount/{name}"

    config = read_config()
    config.setdefault("projects", {})[name] = {
        "host": host,
        "remote_dir": remote_dir,
        "local_dir": local_dir,
    }
    write_config(config)
    ok(f"Added '{name}' ({host}:{remote_dir} -> {local_dir})")
    return 0


def cmd_remove(name):
    if not name:
        err("No project specified.")
        return 1

    config = read_config()
    projects = config.get("projects", {})
    if name not in projects:
        err(f"Project '{name}' not found.")
        return 1

    if is_session_active(name):
        cmd_stop(name)

    yn = input(f"Remove '{RED}{name}{NC}' from config? [y/N]: ")
    if yn.lower().startswith("y"):
        del projects[name]
        write_config(config)
        ok(f"Removed '{name}'")
    else:
        info("Cancelled.")


def cmd_edit():
    editor = os.environ.get("EDITOR", "nvim")
    subprocess.run([editor, str(CONFIG_FILE)])


# ── Interactive Mode ────────────────────────────────────────────────────────


def interactive():
    projects = get_projects()

    if not projects:
        warn("No projects configured.")
        yn = input("Add one now? [Y/n]: ")
        if yn.lower().startswith("n"):
            return
        return cmd_add()

    lines = []
    for name, proj in projects.items():
        state = "[syncing]" if is_session_active(name) else "[stopped]"
        lines.append(
            f"{name:<18} {state:<10} "
            f"{proj['host']}:{proj['remote_dir']}  {proj['local_dir']}"
        )

    result = subprocess.run(
        [
            "fzf",
            "--header",
            "Enter:toggle | Del:remove | ^A:add | ^E:edit config | Esc:quit",
            "--expect=del,ctrl-a,ctrl-e",
            "--ansi",
        ],
        input="\n".join(lines),
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        return

    parts = result.stdout.strip().split("\n", 1)
    key = parts[0]
    selection = parts[1] if len(parts) > 1 else ""
    name = selection.split()[0] if selection else ""

    if key == "del":
        if name:
            cmd_remove(name)
    elif key == "ctrl-a":
        cmd_add()
    elif key == "ctrl-e":
        cmd_edit()
    elif name:
        if is_session_active(name):
            cmd_stop(name)
        else:
            cmd_start(name)


# ── Main ────────────────────────────────────────────────────────────────────

HELP = """\
msync - Mutagen Sync Manager

Usage:
  msync                    Interactive project picker (fzf)
  msync list               List projects and sync status
  msync start <name>       Start syncing a project
  msync stop <name>        Stop syncing a project
  msync status [name]      Show detailed mutagen status
  msync add                Add a new project to config
  msync remove <name>      Remove a project from config
  msync edit               Open config in $EDITOR

Interactive keybindings (fzf):
  Enter    Toggle sync on/off for selected project
  Del      Remove project from config
  Ctrl-A   Add a new project
  Ctrl-E   Edit config file
  Esc      Exit

Config: ~/.config/msync/config.toml"""


def main():
    if not shutil.which("mutagen"):
        err("mutagen not found. Install with: yay -S mutagen.io-bin")
        sys.exit(1)

    ensure_config()

    args = sys.argv[1:]
    cmd = args[0] if args else None
    arg = args[1] if len(args) > 1 else None

    match cmd:
        case "start":
            sys.exit(cmd_start(arg) or 0)
        case "stop":
            sys.exit(cmd_stop(arg) or 0)
        case "status" | "st":
            cmd_status(arg)
        case "list" | "ls":
            cmd_list()
        case "add":
            sys.exit(cmd_add() or 0)
        case "remove" | "rm":
            sys.exit(cmd_remove(arg) or 0)
        case "edit":
            cmd_edit()
        case "help" | "-h" | "--help":
            print(HELP)
        case _:
            interactive()


if __name__ == "__main__":
    main()
