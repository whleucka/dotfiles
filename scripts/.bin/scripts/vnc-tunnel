#!/usr/bin/python
# -*- coding: utf-8 -*-

import os
import re
import subprocess
import sys
import time

hosts = {
    "chainlogic": {"mysql": "chainlogic_cms"},
    "hilt-cms": {"mysql": "cms"},
    "getcoin": {"mysql": "cms"},
    "americabitcoin": {"mysql": "cms"},
}

VNC_PORT = 5900
LOCAL_PORT = 5900


def get_host():
    while True:
        key_list = list(hosts.keys())
        choices = ", ".join(key_list)
        question = f"Please select a connection (default=chainlogic) [{choices}]: "
        host = input(question)
        if host != "" and host in key_list:
            break
        else:
            host = "chainlogic"
            break
    return host


def get_fingerprints(server):
    fingerprints = []
    sql = """SELECT LEFT(Tablet.fingerprint,5) as fingerprint, BTM.id as btm_id, Location.name
    FROM Location INNER JOIN BTM ON BTM.location_id = Location.id
    INNER JOIN Tablet ON Tablet.btm_id = BTM.id
    WHERE Location.enabled = 1
    ORDER BY Location.name"""
    mysql_cmd = hosts[server]["mysql"]
    cmd = f"mysql {mysql_cmd} -e '{sql}'"
    lines = subprocess.run(
        ["/usr/bin/ssh", server, cmd], encoding="utf-8", stdout=subprocess.PIPE
    ).stdout.splitlines()
    for line in lines[1:]:
        fingerprint, btm_id, name = line.split("\t")
        fingerprints.append(f"{fingerprint} | {btm_id} | {name}")
    return fingerprints


def select_fingerprint(fingerprints):
    input_str = "\n".join(fingerprints)
    result = subprocess.run(
        ["fzf", "--prompt=Select device: "],
        input=input_str,
        encoding="utf-8",
        stdout=subprocess.PIPE,
    )
    if result.returncode != 0 or not result.stdout.strip():
        print("No selection made, exiting.")
        sys.exit(1)
    selected = result.stdout.strip()
    fingerprint, btm_id, name = selected.split(" | ")
    return fingerprint, name


LOCAL_NETWORK_PREFIX = "192.168.97."


def get_device_ip(host, fingerprint, interface):
    """Get IP from the remote device for a specific interface"""
    cmd = f"pssh {fingerprint} ip -4 addr show {interface}"
    result = subprocess.run(
        ["ssh", host, cmd],
        encoding="utf-8",
        capture_output=True,
    )

    match = re.search(r'inet (\d+\.\d+\.\d+\.\d+)', result.stdout)
    if not match:
        return None

    return match.group(1)


def get_connection_info(host, fingerprint):
    """Determine if device is local or remote and return appropriate IP"""
    print(f"Getting network info from {fingerprint}...")

    # Check eth0 first to see if it's a local device
    eth_ip = get_device_ip(host, fingerprint, "eth0")

    if eth_ip and eth_ip.startswith(LOCAL_NETWORK_PREFIX):
        # Local device - connect directly via eth0 IP
        print(f"Detected local device (eth0: {eth_ip})")
        return eth_ip, True  # IP, is_local

    # Remote device - get tun0 IP for tunnel connection
    tun_ip = get_device_ip(host, fingerprint, "tun0")

    if not tun_ip:
        print(f"Failed to get tunnel IP")
        sys.exit(1)

    return tun_ip, False  # Remote device - use tunnel


def setup_vnc(host, fingerprint):
    """Install and start x11vnc on the remote device"""
    print(f"Setting up x11vnc on {fingerprint}...")

    # Check if x11vnc is installed
    check_cmd = f"pssh {fingerprint} which x11vnc"
    result = subprocess.run(["ssh", host, check_cmd], capture_output=True)

    if result.returncode != 0:
        print("Installing x11vnc...")
        install_cmd = f"pssh {fingerprint} sudo apt-get update && pssh {fingerprint} sudo apt-get install -y x11vnc"
        subprocess.run(["ssh", host, install_cmd])

    # Check if x11vnc is running
    check_running = f"pssh {fingerprint} pgrep -x x11vnc"
    result = subprocess.run(["ssh", host, check_running], capture_output=True)

    if result.returncode != 0:
        print("Starting x11vnc...")
        # Kill any stale x11vnc first
        kill_cmd = f"pssh {fingerprint} 'killall x11vnc 2>/dev/null; sleep 1'"
        subprocess.run(["ssh", host, kill_cmd], capture_output=True)
        # Start x11vnc in background, log to tmp for debugging
        start_cmd = f"pssh {fingerprint} 'nohup /usr/bin/x11vnc -shared -forever -display :0 -rfbport 5900 -nopw -xwarppointer -xrandr -auth guess >/tmp/x11vnc.log 2>&1 &'"
        subprocess.run(["ssh", host, start_cmd])
        # Wait and verify x11vnc is actually listening
        for i in range(5):
            time.sleep(1)
            verify_cmd = f"pssh {fingerprint} 'ss -tlnp | grep 5900'"
            verify = subprocess.run(["ssh", host, verify_cmd], capture_output=True, encoding="utf-8")
            if "5900" in verify.stdout:
                print("x11vnc started and listening on port 5900")
                break
        else:
            # Show logs if it failed to start
            log_cmd = f"pssh {fingerprint} 'cat /tmp/x11vnc.log 2>/dev/null | tail -20'"
            log_result = subprocess.run(["ssh", host, log_cmd], capture_output=True, encoding="utf-8")
            print(f"WARNING: x11vnc may not be running. Logs:\n{log_result.stdout}")
    else:
        print("x11vnc already running")


def connect_local(device_ip, name):
    """Connect directly to a local device via VNC"""
    print(f"Connecting directly to local device {name} at {device_ip}:{VNC_PORT}...")
    print("Tip: Set 'Scale to fit window' in Remmina preferences for auto-scaling")
    try:
        subprocess.Popen(["remmina", "-c", f"vnc://{device_ip}:{VNC_PORT}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"\nConnected to {name}. Press Enter to exit...")
        input()
    except KeyboardInterrupt:
        pass


def create_tunnel_and_connect(host, tunnel_ip, name):
    """Create SSH tunnel through host to device, then connect VNC"""

    # Kill any existing tunnel on this port
    subprocess.run(["fuser", "-k", f"{LOCAL_PORT}/tcp"], stderr=subprocess.DEVNULL)

    print(f"Creating SSH tunnel: localhost:{LOCAL_PORT} -> {host} -> {tunnel_ip}:{VNC_PORT}")

    # Create SSH tunnel in background
    tunnel_proc = subprocess.Popen(
        ["ssh", "-fNL", f"{LOCAL_PORT}:{tunnel_ip}:{VNC_PORT}", host],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    tunnel_proc.wait()

    time.sleep(1)

    print(f"Connecting VNC to {name}...")
    try:
        subprocess.Popen(["remmina", "-c", f"vnc://localhost:{LOCAL_PORT}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"\nTunnel active to {name}. Press Enter to close tunnel...")
        input()
    except KeyboardInterrupt:
        pass
    finally:
        # Cleanup tunnel
        print("Closing tunnel...")
        subprocess.run(["fuser", "-k", f"{LOCAL_PORT}/tcp"], stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    host = get_host()
    fingerprints = get_fingerprints(host)
    fingerprint, name = select_fingerprint(fingerprints)

    print(f"Selected: {name} ({fingerprint})")

    device_ip, is_local = get_connection_info(host, fingerprint)
    setup_vnc(host, fingerprint)

    if is_local:
        print(f"Device local IP: {device_ip}")
        connect_local(device_ip, name)
    else:
        print(f"Device tunnel IP: {device_ip}")
        create_tunnel_and_connect(host, device_ip, name)
