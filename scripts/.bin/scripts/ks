#!/usr/bin/env bash

# ks - Kitty Session Manager (tmux-backed)
#
# Persistent sessions using tmux as the backend, kitty as the renderer.
# tmux runs invisibly (no status bar, no keybindings) — just persistence.
#
# Usage:
#   ks                  Interactive session picker (fzf)
#   ks list             List sessions (attached/detached)
#   ks new <name> [dir] Create and attach to a new session
#   ks attach <name>    Attach to an existing session
#   ks delete <name>    Kill a session
#   ks rename <old>     Rename a session

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

info()  { printf "${BLUE}:: ${NC}%s\n" "$*"; }
ok()    { printf "${GREEN}:: ${NC}%s\n" "$*"; }
warn()  { printf "${YELLOW}:: ${NC}%s\n" "$*"; }
err()   { printf "${RED}:: ${NC}%s\n" "$*" >&2; }

# ── Helper Functions ─────────────────────────────────────────────────────────

# List sessions formatted for display
list_sessions_formatted() {
    tmux list-sessions -F '#{session_name}|#{session_windows}|#{session_attached}|#{session_path}' 2>/dev/null | \
    while IFS='|' read -r name windows attached path; do
        if [ "$attached" -gt 0 ]; then
            state="${GREEN}attached${NC}"
        else
            state="${DIM}detached${NC}"
        fi
        printf "%-20s %bwindows:%-3s %b%b\n" "$name" "$CYAN" "$windows" "$state" "$NC"
    done
}

# List session names only (for fzf)
list_session_names() {
    tmux list-sessions -F '#{session_name}' 2>/dev/null
}

attach_session() {
    local name="$1"
    if ! tmux has-session -t "$name" 2>/dev/null; then
        err "Session '$name' does not exist."
        return 1
    fi

    if [ -n "$TMUX" ]; then
        # Already inside tmux — switch client
        tmux switch-client -t "$name"
    else
        tmux attach-session -t "$name"
    fi
}

new_session() {
    local name="$1"
    local dir="${2:-$(pwd)}"

    if [ -z "$name" ]; then
        printf "Session name: "
        read -r name
        [ -z "$name" ] && { err "No name provided."; return 1; }
    fi

    if tmux has-session -t "$name" 2>/dev/null; then
        err "Session '$name' already exists. Use 'ks attach $name'."
        return 1
    fi

    # Expand ~ to $HOME
    dir="${dir/#\~/$HOME}"

    if [ ! -d "$dir" ]; then
        err "Directory '$dir' does not exist."
        return 1
    fi

    if [ -n "$TMUX" ]; then
        # Inside tmux — create session detached, then switch
        tmux new-session -d -s "$name" -c "$dir"
        tmux switch-client -t "$name"
    else
        tmux new-session -s "$name" -c "$dir"
    fi
}

delete_session() {
    local name="$1"
    if [ -z "$name" ]; then
        err "No session specified."
        return 1
    fi
    if ! tmux has-session -t "$name" 2>/dev/null; then
        err "Session '$name' does not exist."
        return 1
    fi
    printf "Kill session '${RED}%s${NC}'? [y/N]: " "$name"
    read -r yn
    case "$yn" in
        [yY]*) tmux kill-session -t "$name" && ok "Killed: $name" ;;
        *) info "Cancelled." ;;
    esac
}

rename_session() {
    local old_name="$1"
    if [ -z "$old_name" ]; then
        err "No session specified."
        return 1
    fi
    if ! tmux has-session -t "$old_name" 2>/dev/null; then
        err "Session '$old_name' does not exist."
        return 1
    fi
    printf "New name for '%s': " "$old_name"
    read -r new_name
    if [ -z "$new_name" ]; then
        err "No name provided."
        return 1
    fi
    if tmux has-session -t "$new_name" 2>/dev/null; then
        err "Session '$new_name' already exists."
        return 1
    fi
    tmux rename-session -t "$old_name" "$new_name"
    ok "Renamed: $old_name -> $new_name"
}

# ── Interactive Mode ─────────────────────────────────────────────────────────

interactive() {
    while true; do
        local sessions
        sessions=$(list_session_names)

        if [ -z "$sessions" ]; then
            warn "No tmux sessions found."
            printf "Create one? [Y/n]: "
            read -r yn
            case "$yn" in
                [nN]*) return 0 ;;
                *) new_session; return $? ;;
            esac
        fi

        # Build display list with status
        local display
        display=$(tmux list-sessions -F '#{session_name} (#{session_windows}w) #{?session_attached,[attached],[detached]}' 2>/dev/null)

        local result
        result=$(printf '%s\n' "$display" | fzf \
            --height 40% --reverse --border rounded \
            --header "Enter:attach | Del:kill | ^R:rename | ^A:new | Esc:quit" \
            --expect=del,ctrl-r,ctrl-a \
            --ansi)

        # User cancelled
        if [ -z "$result" ]; then
            return 0
        fi

        local key selection name
        key=$(echo "$result" | sed -n '1p')
        selection=$(echo "$result" | sed -n '2p')
        # Extract session name (first word before the space)
        name=$(echo "$selection" | awk '{print $1}')

        case "$key" in
            del)
                [ -n "$name" ] && delete_session "$name"
                ;;
            ctrl-r)
                [ -n "$name" ] && rename_session "$name"
                ;;
            ctrl-a)
                new_session
                return $?
                ;;
            *)
                # Enter — attach
                if [ -n "$name" ]; then
                    attach_session "$name"
                    return $?
                fi
                ;;
        esac
    done
}

# ── Subcommand Dispatch ──────────────────────────────────────────────────────

case "${1:-}" in
    new)
        new_session "$2" "$3"
        ;;
    attach|a)
        attach_session "$2"
        ;;
    list|ls)
        sessions=$(list_sessions_formatted)
        if [ -z "$sessions" ]; then
            warn "No tmux sessions."
        else
            printf "%b" "$sessions"
        fi
        ;;
    delete|rm|kill)
        delete_session "$2"
        ;;
    rename|mv)
        rename_session "$2"
        ;;
    help|-h|--help)
        cat << 'EOF'
ks - Kitty Session Manager (tmux-backed)

Usage:
  ks                  Interactive session picker (fzf)
  ks list             List sessions with status
  ks new <name> [dir] Create and attach to a new session
  ks attach <name>    Attach to an existing session
  ks rename <name>    Rename a session
  ks delete <name>    Kill a session

Interactive keybindings (fzf):
  Enter    Attach to selected session
  Del      Kill selected session
  Ctrl-R   Rename selected session
  Ctrl-A   Create a new session
  Esc      Exit

Sessions persist across kitty restarts. Close kitty, reopen,
run ks — your processes are still running.
EOF
        ;;
    *)
        interactive
        ;;
esac
