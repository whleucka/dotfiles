#!/usr/bin/env bash
# write-usb <iso> <device> [blocksize]
# Write an image to a block device with an accurate progress bar.
set -euo pipefail

input=${1:?usage: write-usb <iso> <device> [blocksize]}
output=${2:?usage: write-usb <iso> <device> [blocksize]}
blocksize=${3:-4M}

[[ -f "$input"  ]] || { echo "input is not a file: $input"        >&2; exit 1; }
[[ -b "$output" ]] || { echo "output is not a block device: $output" >&2; exit 1; }

# Authenticate up front so the sudo password prompt doesn't appear mid-write and
# clobber the pv progress bar.
sudo -v

size=$(stat -c%s "$input")

# oflag=direct bypasses the page cache, so dd writes straight to the device and
# back-pressures the pipe — that's what makes pv's bar track the REAL write
# speed instead of racing to 100% as the kernel cache fills. conv=fsync + the
# trailing sync guarantee everything is flushed before we report success, so the
# stick is safe to pull the moment this returns.
pv -tpreb -s "$size" "$input" \
  | sudo dd of="$output" bs="$blocksize" conv=fsync oflag=direct status=none
sync

echo "Done: wrote $input -> $output"
