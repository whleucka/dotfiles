{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"],
    "modules-center": ["clock"],
    "modules-right": ["group/tray-drawer", "custom/weather", "cpu", "memory", "pulseaudio", "custom/battery"],

    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 1",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 1"
    },

    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 2",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 2"
    },

    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 3",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 3"
    },

    "custom/ws4": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 4",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 4"
    },

    "custom/ws5": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 5",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 5"
    },

    "custom/ws6": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 6 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 6"
    },

    "custom/ws7": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 7 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 7"
    },

    "custom/ws8": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 8 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 8"
    },

    "custom/ws9": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 9 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 9"
    },

    "custom/ws10": {
        "exec": "~/.config/waybar/scripts/ws-button.sh 10 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click.sh 10"
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "timezone": "America/Edmonton",
        "on-click": "kitty calcurse",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "tooltip-format": "Load avg: {loadavg}",
        "interval": 2,
        "on-click": "kitty btop"
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "interval": 10,
        "on-click": "kitty btop"
    },

    "custom/weather": {
        "format": "{}",
        "exec": "~/.dotfiles/hyprland/.config/waybar/scripts/weather.sh",
        "interval": 600,
        "tooltip": true,
        "on-click": "xdg-open 'https://weather.gc.ca/en/location/index.html?coords=49.693,-112.835'",
        "return-type": "json"
    },

    "custom/battery": {
        "exec": "~/.dotfiles/hyprland/.config/waybar/scripts/battery.sh",
        "interval": 5,
        "return-type": "json",
        "tooltip": true,
        "on-click-right": "~/.dotfiles/hyprland/.config/waybar/scripts/cycle-power-profile.sh",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰖁 muted",
      "on-click": "pavucontrol",
      "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +1%",
      "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -1%",
      "scroll-step": 1,
      "format-icons": {
        "muted": "󰖁",
        "default": ["󰕿", "󰖀", "󰕾"]
      }
    },

    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/tray-tag",
            "tray"
        ]
    },

    "custom/tray-tag": {
        "format": "❮",
        "tooltip": false
    },

    "tray": {
        "spacing": 14,
        "icon-size": 16,
        "show-passive-items": true
    }
}
