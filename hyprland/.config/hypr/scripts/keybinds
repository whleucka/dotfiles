#!/bin/bash
# Show hyprland keybinds in fuzzel

# hyprctl binds -j emits malformed JSON on Hyprland 0.56.0 for Lua-registered
# binds (unquoted values, shuffled fields), so parse the plain-text output instead.
hyprctl binds | awk '
  BEGIN { RS = ""; FS = "\n" }
  {
    modmask = ""; submap = ""; key = ""; description = ""
    for (i = 1; i <= NF; i++) {
      line = $i
      if (match(line, /^\tmodmask: /))     modmask = substr(line, RLENGTH + 1)
      else if (match(line, /^\tsubmap: /))     submap = substr(line, RLENGTH + 1)
      else if (match(line, /^\tkey: /))           key = substr(line, RLENGTH + 1)
      else if (match(line, /^\tdescription: /)) description = substr(line, RLENGTH + 1)
    }
    if (description == "" || submap != "") next

    mods = ""
    if (int(modmask / 64) % 2 == 1) mods = mods "Super+"
    if (int(modmask / 4) % 2 == 1)  mods = mods "Ctrl+"
    if (int(modmask / 8) % 2 == 1)  mods = mods "Alt+"
    if (int(modmask / 1) % 2 == 1)  mods = mods "Shift+"

    print mods key "  " description
  }
' | sort | fuzzel --dmenu > /dev/null
