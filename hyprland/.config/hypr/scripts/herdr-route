#!/usr/bin/env bash
# herdr-route: nav + resize router for herdr, paired with herdr-splits.nvim.
#
# Splits ownership by pane type. In a pane running (n)vim, the key is forwarded
# into neovim and herdr-splits.nvim owns the whole decision (nvim splits ->
# herdr panes -> Hyprland, via its at_edge callback). In any other pane, this
# script decides, because herdr-splits.nvim's own herdr-side script only knows
# wrap/stop at herdr's outer edge and can never escalate to Hyprland.
#
# Replaces herdr-nav (kept alongside for rollback: revert the [[keys.command]]
# blocks in ~/.config/herdr/config.toml to point back at it).
#
#   herdr-route nav    <h|j|k|l> <left|right|up|down>
#   herdr-route resize <h|j|k|l> <left|right|up|down>
#
# Why not the plugin's shipped scripts/herdr-nav.sh + scripts/herdr-resize.sh:
#   1. herdr-nav.sh wraps to the opposite pane at herdr's outer edge with no
#      hook to escalate, so the Hyprland hop is unreachable from a shell pane.
#   2. Both resolve the pane with `--current`, whose resolution in a keybind's
#      shell context is ambiguous. We resolve from `pane layout` (focused=true)
#      and pass --pane explicitly, as herdr-nav did.
# Edge detection now uses `pane edges`, which returns all four edge flags plus
# the zoomed state in a single call — the reason the old focus.changed probe
# (2-3 round trips per keypress) is gone.

# herdr's server is a lazy daemon spawned by the first `kitty herdr` client from
# Hyprland, so it captures Hyprland's session PATH — which does NOT include
# ~/.local/bin (where the herdr binary lives). Shell-command keybinds inherit
# that PATH, so a bare `herdr` here would be "command not found" and every pane
# query would silently fail.
export PATH="$HOME/.local/bin:$PATH"

scripts_dir="$HOME/.config/hypr/scripts"

# Divider step for pane resizes. Matches the 0.05 the plain alt+hjkl binds used.
resize_amount=0.05

hd() { herdr pane "$@" 2>/dev/null; }

# Letter (h|j|k|l) -> the l|r|u|d that scripts/focus expects for Hyprland.
focus_letter() { case "$1" in h) echo l;; j) echo d;; k) echo u;; l) echo r;; esac; }

# The truly-focused pane in the current tab (authoritative).
focused_pane() {
  hd layout | jq -r '.result.layout.panes[] | select(.focused).pane_id' | head -1
}

# Is $1 running (n)vim (or a full-screen picker) in the foreground?
pane_is_vim() {
  hd process-info --pane "$1" \
    | jq -r '.result.process_info.foreground_processes[].name' 2>/dev/null \
    | grep -qiE '^(n?vim|view|fzf)(diff)?$'
}

mode="${1:-}"
key="${2:-}"
word="${3:-}"

case "$mode" in
  nav|resize) ;;
  *)
    echo "usage: herdr-route nav|resize <h|j|k|l> <left|right|up|down>" >&2
    exit 2
    ;;
esac

cur=$(focused_pane)

# No pane resolved: for nav, fail toward the Hyprland hop rather than a dead
# key; for resize there is nothing sensible to do.
if [ -z "$cur" ]; then
  [ "$mode" = nav ] && exec "$scripts_dir/focus" "$(focus_letter "$key")"
  exit 0
fi

# --- vim pane: hand the whole decision to herdr-splits.nvim -----------------
# nav forwards ctrl+alt+<key>, resize forwards alt+<key>; both match the
# keymaps in nvim/.config/nvim/lua/plugins/herdr-splits.lua.
if pane_is_vim "$cur"; then
  if [ "$mode" = nav ]; then
    hd send-keys "$cur" "ctrl+alt+$key" >/dev/null
  else
    hd send-keys "$cur" "alt+$key" >/dev/null
  fi
  exit 0
fi

# --- plain pane: we own it --------------------------------------------------
if [ "$mode" = resize ]; then
  hd resize --direction "$word" --amount "$resize_amount" --pane "$cur" >/dev/null
  exit 0
fi

# nav. One `pane edges` call gives every edge flag and the zoomed state.
edges=$(hd edges --pane "$cur")

# A zoomed pane fills the tab and so reports itself at every edge, making the
# flags useless. Unzoom first (matching herdr-splits.nvim's unzoom_on_nav
# default), then re-read so the escalation decision is based on real geometry.
if [ "$(printf '%s' "$edges" | jq -r '.result.edges.layout.zoomed')" = "true" ]; then
  hd zoom --off --pane "$cur" >/dev/null
  edges=$(hd edges --pane "$cur")
fi

at_edge=$(printf '%s' "$edges" | jq -r --arg d "$word" '.result.edges[$d]')

if [ "$at_edge" = "true" ]; then
  # herdr's outer edge — hand off to the Hyprland window. This is the branch
  # the plugin's shipped script cannot express.
  exec "$scripts_dir/focus" "$(focus_letter "$key")"
fi

# A herdr pane exists that way; if the move unexpectedly fails, escalate rather
# than eat the keypress.
changed=$(hd focus --direction "$word" --pane "$cur" | jq -r '.result.focus.changed')
[ "$changed" = "true" ] && exit 0
exec "$scripts_dir/focus" "$(focus_letter "$key")"
