#!/usr/bin/env bash
# herdr-swap: move the focused pane forward/backward through its tab's pane
# order, wrapping at the ends — herdr's analog of tmux `swap-pane -D` / `-U`.
#
# herdr's native `pane swap` is directional (left/right/up/down) only; there is
# no built-in "cycle through the pane order". This walks the linear pane list of
# the current tab so ctrl+shift+f/b behave like tmux's positional swap.
#
#   herdr-swap f   swap with next pane     (forward,  wraps to first)
#   herdr-swap b   swap with previous pane (backward, wraps to last)
#
# Panes are ordered SPATIALLY, in reading order (top-to-bottom, left-to-right),
# which is what tmux pane indexes effectively track. Ordering by pane_id does
# not work here: ids are base36-ish (p1 p2 pF pK), and more importantly a swap
# moves panes between positions without changing their ids — since herdr keeps
# focus on the pane that moved, an id-ordered list leaves the focused pane at
# the same index and repeated presses just bounce it between two slots.

# herdr's server (a lazy daemon spawned by the first client under Hyprland)
# inherits a PATH without ~/.local/bin, where the herdr binary lives. Shell
# keybinds inherit that PATH, so make this script PATH-independent.
export PATH="$HOME/.local/bin:$PATH"

dir="${1:-}"
case "$dir" in f|b) ;; *) echo "usage: herdr-swap <f|b>" >&2; exit 2;; esac

layout=$(herdr pane layout 2>/dev/null) || exit 1

cur=$(jq -r '.result.layout.focused_pane_id' <<<"$layout")
[ -z "$cur" ] || [ "$cur" = "null" ] && exit 0

# Pane ids in this tab, in on-screen reading order: top row first, then left to
# right within a row. Each pane's rect is its current position, so this list is
# recomputed against the post-swap layout on every press.
mapfile -t panes < <(jq -r '
  .result.layout.panes
  | sort_by(.rect.y, .rect.x)
  | .[].pane_id' <<<"$layout")

n=${#panes[@]}
[ "$n" -lt 2 ] && exit 0   # nothing to swap with

idx=-1
for i in "${!panes[@]}"; do
  [ "${panes[$i]}" = "$cur" ] && { idx=$i; break; }
done
[ "$idx" -lt 0 ] && exit 0

if [ "$dir" = "f" ]; then
  tgt=$(( (idx + 1) % n ))
else
  tgt=$(( (idx - 1 + n) % n ))
fi

herdr pane swap --source-pane "$cur" --target-pane "${panes[$tgt]}" >/dev/null 2>&1
