#!/usr/bin/env bash
# herdr-swap: move the focused pane forward/backward through its tab's pane
# order, wrapping at the ends — herdr's analog of tmux `swap-pane -D` / `-U`.
#
# herdr's native `pane swap` is directional (left/right/up/down) only; there is
# no built-in "cycle through the pane order". This walks the linear pane list of
# the current tab so ctrl+shift+f/b behave like tmux's positional swap.
#
#   herdr-swap f   swap with next pane     (forward,  wraps to first)
#   herdr-swap b   swap with previous pane (backward, wraps to last)
#
# Panes are ordered by the numeric suffix of their pane_id (creation order),
# matching tmux's pane-index ordering rather than spatial position.

dir="${1:-}"
case "$dir" in f|b) ;; *) echo "usage: herdr-swap <f|b>" >&2; exit 2;; esac

layout=$(herdr pane layout 2>/dev/null) || exit 1

cur=$(jq -r '.result.layout.focused_pane_id' <<<"$layout")
[ -z "$cur" ] || [ "$cur" = "null" ] && exit 0

# Pane ids in this tab, ordered by the number after ":p" (creation order).
mapfile -t panes < <(jq -r '.result.layout.panes[].pane_id' <<<"$layout" \
  | sort -t: -k2.2 -n)

n=${#panes[@]}
[ "$n" -lt 2 ] && exit 0   # nothing to swap with

idx=-1
for i in "${!panes[@]}"; do
  [ "${panes[$i]}" = "$cur" ] && { idx=$i; break; }
done
[ "$idx" -lt 0 ] && exit 0

if [ "$dir" = "f" ]; then
  tgt=$(( (idx + 1) % n ))
else
  tgt=$(( (idx - 1 + n) % n ))
fi

herdr pane swap --source-pane "$cur" --target-pane "${panes[$tgt]}" >/dev/null 2>&1
