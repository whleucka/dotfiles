#!/usr/bin/env bash
#
# Will Hleucka william.hleucka@gmail.com
#

alias h="history -E"

alias j='source job-viewer'

if command -v udisksctl >/dev/null; then
  alias mount-usb="udisksctl mount -b"
  alias unmount-usb="udisksctl unmount -b"
fi

if command -v docker >/dev/null; then
  alias dc="docker compose"
  alias dcu="docker compose up"
  alias dcud="docker compose up -d"
  alias dcd="docker compose down"
  alias dcr="docker compose restart"
  alias dcb="docker compose build"
  alias dcub="docker compose up --build"
  alias dcl="docker compose logs"
  alias dclf="docker compose logs -f"
  alias dce="docker compose exec"
  alias dcrun="docker compose run --rm"
  alias dcps="docker compose ps"
  alias dcpull="docker compose pull"
  alias dck="docker compose kill"
  alias dcnuke="docker compose down -v --remove-orphans && docker compose up -d --build"
fi

dcebash() {
  docker compose exec "$1" bash
}

# ncdu
if command -v ncdu >/dev/null; then
  alias du="ncdu -x "
fi

# composer
if command -v composer >/dev/null; then
  alias cu="composer update"
  alias cr="composer require "
fi

# pnpm
if command -v pnpm >/dev/null; then
  alias npm="pnpm"
fi

# npm
if command -v npm >/dev/null; then
  alias naf="npm audit fix"
  alias npi="npm install"
  alias npu="npm update"
  alias nrw="npm run watch"
  alias nrb="npm run build"
  alias nrd="npm run dev"
  alias nrp="npm run prod"
  alias nrh="npm run hot"
fi

# clear
alias c="clear"

# grep
alias grep="grep --color=auto"

# copy
alias cp="cp -ivr"

# mkdir
alias mkdir="mkdir -pv"

# do not delete / or prompt if deleting more than 3 files at a time #
alias rm='rm -I --preserve-root'

# confirmation #
alias mv='mv -i'
alias cp='cp -i'
alias ln='ln -i'

# Parenting changing perms on / #
alias chown='chown --preserve-root'
alias chmod='chmod --preserve-root'
alias chgrp='chgrp --preserve-root'

# become root #
alias root='sudo -i'
alias su='sudo -i'

# reboot / halt / poweroff
alias reboot='sudo /sbin/reboot'
alias poweroff='sudo /sbin/poweroff'
alias halt='sudo /sbin/halt'
alias shutdown='sudo /sbin/shutdown'

# wget
alias wget='wget -c'

# ping
alias ping='ping -c 5'

# kittens
alias s="ssh "
alias icat="kitty +kitten icat"

# git
alias g="git"
alias ga='git add'
alias gb='git branch'
alias gbD='git branch -D'
alias gbd='git branch -d'
alias gc!="git commit -v"
alias gc='git commit'
alias gcA='git commit --amend'
alias gca!='git commit -av'
alias gca='git commit -a'
alias gcam='git commit -am'
alias gcb="git checkout -b"
alias gcm="git commit -m"
alias gco='git checkout'
alias gcp='git cherry-pick'
alias gf='git fetch'
alias gl="git log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'"
alias gm='git merge'
alias gpl='git pull'
alias gpu='git push'
alias gpsu='git push --set-upstream'
alias grb='git rebase'
alias gs='git status'

# yay
if command -v yay >/dev/null; then
  alias upg='yay -Syu -y'
elif command -v apt >/dev/null; then
  alias upg='sudo apt update && sudo apt upgrade -y'
fi
if command -v yay >/dev/null; then
  alias upd='yay -Sy'
elif command -v apt >/dev/null; then
  alias upd='sudo apt update'
fi

# nvim
if command -v nvim >/dev/null; then
  alias v="nvim"
elif command -v vim >/dev/null; then
  alias v="vim"
fi

# transf files / folders
if command -v rsync >/dev/null; then
  alias rs='rsync -rzvhP '
fi

# list directories
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
