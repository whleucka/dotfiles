[Unit]
Description=tmux server (keepalive + continuum session restore)
Documentation=man:tmux(1)

[Service]
Type=oneshot
RemainAfterExit=yes
# Creating __server starts the tmux server, which sources tmux.conf and
# triggers tmux-continuum's auto-restore of saved sessions.
# ks (kitty session manager) hides the __server session from listings.
ExecStart=/bin/sh -c 'tmux has-session -t __server 2>/dev/null || tmux new-session -d -s __server'
ExecStop=/bin/sh -c 'tmux kill-server 2>/dev/null || true'

[Install]
WantedBy=default.target
